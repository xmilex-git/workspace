diff --git a/src/base/tla_trace.h b/src/base/tla_trace.h
new file mode 100644
index 0000000000..d00d206751
--- /dev/null
+++ b/src/base/tla_trace.h
@@ -0,0 +1,46 @@
+/* scratch TLATRACE helper (CBRD-27430 B1a trace validation) */
+#ifndef _TLA_TRACE_H_
+#define _TLA_TRACE_H_
+#include <fcntl.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <time.h>
+#include <unistd.h>
+#include <sys/syscall.h>
+#include <string.h>
+static inline long long
+tla_now (void)
+{
+  struct timespec ts;
+  clock_gettime (CLOCK_MONOTONIC, &ts);
+  return (long long) ts.tv_sec * 1000000000LL + ts.tv_nsec;
+}
+static inline void
+tla_trace_at (long long ns, const char *fmt, ...)
+{
+  const char *path = getenv ("CUBRID_TLATRACE_OUT");
+  char buf[1024];
+  int n;
+  va_list ap;
+  int fd;
+  if (path == NULL || path[0] == '\0')
+    {
+      return;
+    }
+  n = snprintf (buf, sizeof (buf), "TLATRACE %lld %d ", ns, (int) getpid ());
+  va_start (ap, fmt);
+  n += vsnprintf (buf + n, sizeof (buf) - n - 1, fmt, ap);
+  va_end (ap);
+  buf[n++] = '\n';
+  fd = open (path, O_WRONLY | O_APPEND | O_CREAT, 0644);
+  if (fd >= 0)
+    {
+      (void) write (fd, buf, n);
+      close (fd);
+    }
+}
+#define tla_trace(...) tla_trace_at (tla_now (), __VA_ARGS__)
+#define TLA_TID ((int) syscall (SYS_gettid))
+static inline int tla_knob (const char *name) { const char *v = getenv (name); return v != NULL && v[0] == '1'; }
+#endif
