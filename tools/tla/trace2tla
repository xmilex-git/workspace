#!/usr/bin/env python3
# usage: tools/tla/trace2tla <Module> <Op>=<logfile> [<Op>=<logfile> ...] > <Module>.tla
#
# Turns event lines an instrumented CUBRID build wrote into a TLA+ module that defines one
# sequence of records per log, for trace validation against a spec (cubrid-tla skill, "Trace
# validation"). An event line holds the marker anywhere in it, then the action, the process
# and optional key=value fields:
#     ... TLATRACE seq=17 a=W_run p=w2 err=1 ...
# seq orders events that different threads wrote; without it the file order is used.
# Integers become TLA+ numbers, everything else a string. A log with no event is an error.
import re
import sys

MARK = "TLATRACE"
NAME = re.compile(r"^[A-Za-z][A-Za-z0-9_]*$")


def value(v):
    if re.fullmatch(r"-?[0-9]+", v):
        return v
    return '"' + v.replace("\\", "\\\\").replace('"', '\\"') + '"'


def records(path):
    out = []
    with open(path, errors="replace") as f:
        for n, line in enumerate(f, 1):
            i = line.find(MARK)
            if i < 0:
                continue
            fields = {}
            for tok in line[i + len(MARK):].split():
                k, sep, v = tok.partition("=")
                if not sep or not NAME.match(k):
                    sys.exit("%s:%d: field %r is not key=value" % (path, n, tok))
                fields[k] = v
            if "a" not in fields or "p" not in fields:
                sys.exit("%s:%d: event needs a=<action> and p=<process>" % (path, n))
            out.append(fields)
    if not out:
        sys.exit("%s: no %s line" % (path, MARK))
    if all("seq" in r for r in out):
        out.sort(key=lambda r: int(r["seq"]))
    elif any("seq" in r for r in out):
        sys.exit("%s: seq= is on some events but not all" % path)
    for r in out:
        r.pop("seq", None)
    return out


def main():
    if len(sys.argv) < 3 or not NAME.match(sys.argv[1]):
        sys.exit(__doc__ if __doc__ else "usage: trace2tla <Module> <Op>=<logfile>...")
    print("---- MODULE %s ----" % sys.argv[1])
    print("\\* Generated by tools/tla/trace2tla from: %s" % " ".join(sys.argv[2:]))
    for arg in sys.argv[2:]:
        op, sep, path = arg.partition("=")
        if not sep or not NAME.match(op):
            sys.exit("argument %r is not <Op>=<logfile>" % arg)
        recs = records(path)
        print("%s == <<" % op)
        print(",\n".join("  [" + ", ".join("%s |-> %s" % (k, value(v)) for k, v in r.items()) + "]"
                         for r in recs))
        print(">>")
    print("====")


main()
