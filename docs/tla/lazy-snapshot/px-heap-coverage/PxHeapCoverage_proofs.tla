------------------------- MODULE PxHeapCoverage_proofs -------------------------
(* TLAPS proof that IndInv is an inductive invariant of the fix (the snapshot exists
   before the bitmap is collected, a bitmap page that is no longer a heap page is
   skipped) and that it implies C1 (Coverage), C2 (NoLoss), C3 (HeapOnly) and C4
   (SameAsSnapshot) for any number of workers, pages and rows: the premises of the
   TLA rule INV1 (cubrid-tla PROOFS.md). One lemma per action; within it each typing
   part and each conjunct of IndInv is its own step (cubrid-tla P4, P15). *)
EXTENDS PxHeapCoverage, TLAPS
\* timeout: 3600

ASSUME Fix == SnapshotAt # "worker_start" /\ PtypeCheck /\ Mutant = "none"

USE Assm, Fix DEF Pg, Rows, NoPage, States

THEOREM InitInv == Init => IndInv
<1> SUFFICES ASSUME Init PROVE IndInv
  OBVIOUS
<1>1. BoolOK BY DEF Init, BoolOK
<1>2. NatOK BY DEF Init, NatOK, IsInit
<1>3. SetOK BY DEF Init, SetOK
<1>4. R_fix BY <1>1, <1>2, <1>3 DEF Init, IndInv, TypeOK, BoolOK, NatOK, SetOK, R_fix, R_snap, R_q, R_qs, R_lsnap, R_clock, R_order, R_home, R_init, R_gone, R_alloc, R_vis, R_open, R_start, R_left, R_bitmap, R_count, R_done, R_foreign, VisibleAt, OldestVisible, PageEmpty, Build, IsInit, dataVars, scanVars
