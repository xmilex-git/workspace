--- a/src/transaction/mvcc_table.cpp
+++ b/src/transaction/mvcc_table.cpp
@@ -29,6 +29,47 @@
 #include "thread_manager.hpp"
 
 #include <cassert>
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+#include <unistd.h>
+
+/* TLA+ probe (scratch only) */
+static FILE *tla_trace_fp = NULL;
+static std::once_flag tla_trace_once;
+static std::mutex tla_trace_mutex;
+static unsigned long long tla_trace_seq = 0;
+thread_local int tla_in_build = 0;
+void
+tla_trace (const char *fmt, ...)
+{
+  std::call_once (tla_trace_once, [] ()
+  {
+    const char *p = getenv ("CUBRID_TLA_TRACE_FILE");
+    if (p != NULL)
+      {
+	tla_trace_fp = fopen (p, "a");
+      }
+  });
+  if (tla_trace_fp == NULL)
+    {
+      return;
+    }
+  std::lock_guard<std::mutex> g (tla_trace_mutex);
+  fprintf (tla_trace_fp, "TLATRACE seq=%llu ", tla_trace_seq++);
+  va_list ap;
+  va_start (ap, fmt);
+  vfprintf (tla_trace_fp, fmt, ap);
+  va_end (ap);
+  fputc ('\n', tla_trace_fp);
+  fflush (tla_trace_fp);
+}
+static int
+tla_env_ms (const char *name)
+{
+  const char *v = getenv (name);
+  return v != NULL ? atoi (v) : 0;
+}
