diff --git a/src/storage/file_io.c b/src/storage/file_io.c
index 1afa9abbb..480348918 100644
--- a/src/storage/file_io.c
+++ b/src/storage/file_io.c
@@ -4454,6 +4454,346 @@ fileio_fsync_pending (void)
   return true;
 }
 
+#if defined (SERVER_MODE)
+#if defined (HAVE_LIBURING)
+#include <liburing.h>
+
+#define FILEIO_AIO_REAP_BATCH 32
+
+typedef struct fileio_aio_ring FILEIO_AIO_RING;
+struct fileio_aio_ring
+{
+  struct io_uring ring;
+  pthread_mutex_t cq_mutex;	/* one thread at a time takes completions off this ring */
+  std::atomic<bool> is_inited;	/* set once by the owner thread before its first read is visible to others */
+  int staged;			/* prepared and not yet submitted; owner thread only */
+  std::atomic<int> inflight;	/* submitted and not yet reaped */
+};
+
+static FILEIO_AIO_RING *fileio_Aio_rings = NULL;
+static int fileio_Aio_num_rings = 0;
+static pthread_once_t fileio_Aio_once = PTHREAD_ONCE_INIT;
+
+static void fileio_aio_initialize_once (void);
+static FILEIO_AIO_RING *fileio_aio_get_my_ring (THREAD_ENTRY * thread_p);
+static int fileio_aio_drain_locked (THREAD_ENTRY * thread_p, FILEIO_AIO_RING * aio_ring, FILEIO_AIO_DONE_FUNC done);
+
+/*
+ * fileio_aio_initialize_once () - io_method=io_uring: check once that this kernel takes it
+ *
+ * Note: A thread waiting for another thread's read waits in the kernel on that thread's ring while the owner
+ *       keeps submitting; that is safe only when the wait does not go through the submission queue
+ *       (IORING_FEAT_EXT_ARG). Without it, or when the ring cannot be created, pages are read synchronously.
+ */
+static void
+fileio_aio_initialize_once (void)
+{
+  struct io_uring probe_ring;
+  int rc;
+  char msg[128];
+
+  if (prm_get_integer_value (PRM_ID_IO_METHOD) != IO_METHOD_IO_URING)
+    {
+      return;
+    }
+
+  rc = io_uring_queue_init (FILEIO_AIO_RING_ENTRIES, &probe_ring, 0);
+  if (rc == 0 && (probe_ring.features & IORING_FEAT_EXT_ARG) == 0)
+    {
+      io_uring_queue_exit (&probe_ring);
+      rc = -ENOSYS;
+    }
+  else if (rc == 0)
+    {
+      io_uring_queue_exit (&probe_ring);
+    }
+  if (rc != 0)
+    {
+      snprintf (msg, sizeof (msg), "io_method=io_uring is not usable on this system (io_uring_queue_init: %d); "
+		"pages are read synchronously", rc);
+      er_set (ER_NOTIFICATION_SEVERITY, ARG_FILE_LINE, ER_GENERIC_ERROR, 1, msg);
+      return;
+    }
+
+  fileio_Aio_num_rings = (int) thread_num_total_threads ();
+  fileio_Aio_rings = new FILEIO_AIO_RING[fileio_Aio_num_rings];
+  for (int i = 0; i < fileio_Aio_num_rings; i++)
+    {
+      fileio_Aio_rings[i].is_inited = false;
+      fileio_Aio_rings[i].staged = 0;
+      fileio_Aio_rings[i].inflight = 0;
+      pthread_mutex_init (&fileio_Aio_rings[i].cq_mutex, NULL);
+    }
+}
+
+/*
+ * fileio_aio_is_available () - true when pages can be read ahead through io_uring
+ */
+bool
+fileio_aio_is_available (void)
+{
+  pthread_once (&fileio_Aio_once, fileio_aio_initialize_once);
+  return fileio_Aio_rings != NULL;
+}
+
+/*
+ * fileio_aio_finalize () - close every ring at server shutdown
+ *
+ * Note: Every thread has drained its ring before it went back to its pool, so no request is in flight here.
+ */
+void
+fileio_aio_finalize (void)
+{
+  if (fileio_Aio_rings == NULL)
+    {
+      return;
+    }
+  for (int i = 0; i < fileio_Aio_num_rings; i++)
+    {
+      if (fileio_Aio_rings[i].is_inited)
+	{
+	  assert (fileio_Aio_rings[i].staged == 0 && fileio_Aio_rings[i].inflight == 0);
+	  io_uring_queue_exit (&fileio_Aio_rings[i].ring);
+	}
+      pthread_mutex_destroy (&fileio_Aio_rings[i].cq_mutex);
+    }
+  delete[]fileio_Aio_rings;
+  fileio_Aio_rings = NULL;
+  fileio_Aio_num_rings = 0;
+}
+
+/*
+ * fileio_aio_get_my_ring () - the calling thread's ring, created at its first use
+ */
+static FILEIO_AIO_RING *
+fileio_aio_get_my_ring (THREAD_ENTRY * thread_p)
+{
+  FILEIO_AIO_RING *aio_ring;
+
+  assert (thread_p != NULL && thread_p->index >= 0 && thread_p->index < fileio_Aio_num_rings);
+  aio_ring = &fileio_Aio_rings[thread_p->index];
+  if (!aio_ring->is_inited)
+    {
+      if (io_uring_queue_init (FILEIO_AIO_RING_ENTRIES, &aio_ring->ring, 0) != 0)
+	{
+	  return NULL;
+	}
+      aio_ring->is_inited = true;
+    }
+  return aio_ring;
+}
+
+/*
+ * fileio_aio_prepare_read () - stage the read of one page on the calling thread's ring
+ *   return: NO_ERROR, or ER_FAILED when the ring cannot take one more request now
+ *   cookie(in): handed back to the completion function with the read's result
+ *
+ * Note: Nothing reaches the kernel until fileio_aio_submit (). The caller submits before it returns to code
+ *       that may sleep: a staged request is invisible to the device and to every thread waiting for the page.
+ */
+int
+fileio_aio_prepare_read (THREAD_ENTRY * thread_p, int vol_fd, void *io_page_p, PAGEID page_id, size_t page_size,
+			 void *cookie)
+{
+  FILEIO_AIO_RING *aio_ring;
+  struct io_uring_sqe *sqe;
+
+  aio_ring = fileio_aio_get_my_ring (thread_p);
+  if (aio_ring == NULL || aio_ring->staged + aio_ring->inflight >= FILEIO_AIO_RING_ENTRIES)
+    {
+      return ER_FAILED;
+    }
+  sqe = io_uring_get_sqe (&aio_ring->ring);
+  if (sqe == NULL)
+    {
+      return ER_FAILED;
+    }
+  io_uring_prep_read (sqe, vol_fd, io_page_p, (unsigned) page_size, FILEIO_GET_FILE_SIZE (page_size, page_id));
+  /* a buffered read copies from the page cache: let a kernel worker do the copy, not this thread */
+  io_uring_sqe_set_flags (sqe, IOSQE_ASYNC);
+  io_uring_sqe_set_data (sqe, cookie);
+  aio_ring->staged++;
+  return NO_ERROR;
+}
+
+/*
+ * fileio_aio_submit () - hand every staged request of the calling thread to the kernel
+ *   return: number of requests submitted
+ *   done(in): completion function, used when the ring must be emptied before it takes the requests
+ */
+int
+fileio_aio_submit (THREAD_ENTRY * thread_p, FILEIO_AIO_DONE_FUNC done)
+{
+  FILEIO_AIO_RING *aio_ring;
+  int n, total = 0;
+
+  if (fileio_Aio_rings == NULL)
+    {
+      return 0;
+    }
+  aio_ring = &fileio_Aio_rings[thread_p->index];
+  while (aio_ring->staged > 0)
+    {
+      n = io_uring_submit (&aio_ring->ring);
+      if (n > 0)
+	{
+	  aio_ring->inflight += n;
+	  aio_ring->staged -= n;
+	  total += n;
+	}
+      else if (n == -EINTR || n == -EAGAIN)
+	{
+	  continue;
+	}
+      else
+	{
+	  /* -EBUSY: completions must be taken first. Anything else is not expected from a read request. */
+	  assert (n == -EBUSY);
+	  (void) fileio_aio_reap (thread_p, thread_p->index, 1, done);
+	}
+    }
+  assert (aio_ring->staged == 0);
+  return total;
+}
+
+/*
+ * fileio_aio_drain_locked () - call the completion function for every completion the ring holds
+ *   return: number of completions processed
+ *
+ * Note: The caller holds the ring's cq_mutex.
+ */
+static int
+fileio_aio_drain_locked (THREAD_ENTRY * thread_p, FILEIO_AIO_RING * aio_ring, FILEIO_AIO_DONE_FUNC done)
+{
+  struct io_uring_cqe *cqes[FILEIO_AIO_REAP_BATCH];
+  void *cookies[FILEIO_AIO_REAP_BATCH];
+  int results[FILEIO_AIO_REAP_BATCH];
+  unsigned n, i;
+  int total = 0;
+
+  while ((n = io_uring_peek_batch_cqe (&aio_ring->ring, cqes, FILEIO_AIO_REAP_BATCH)) > 0)
+    {
+      for (i = 0; i < n; i++)
+	{
+	  cookies[i] = io_uring_cqe_get_data (cqes[i]);
+	  results[i] = cqes[i]->res;
+	}
+      io_uring_cq_advance (&aio_ring->ring, n);
+      for (i = 0; i < n; i++)
+	{
+	  done (thread_p, cookies[i], results[i]);
+	}
+      /* after the completion functions: the owner's drain sees its ring empty only when they have finished */
+      aio_ring->inflight -= (int) n;
+      total += (int) n;
+    }
+  return total;
+}
+
+/*
+ * fileio_aio_reap () - process the completions of a thread's ring, the caller's own or another thread's
+ *   return: number of completions processed
+ *   owner_index(in): thread entry index of the ring's owner
+ *   wait_msecs(in): 0 = only what has completed, and nothing when another thread is processing the ring now;
+ *                   > 0 = wait up to this long for one completion
+ *
+ * Note: Any thread may call this for any ring. The thread whose read sits in a ring may be asleep on a latch
+ *       or a lock, so a thread that needs the page completes the read itself.
+ */
+int
+fileio_aio_reap (THREAD_ENTRY * thread_p, int owner_index, int wait_msecs, FILEIO_AIO_DONE_FUNC done)
+{
+  FILEIO_AIO_RING *aio_ring;
+  struct io_uring_cqe *cqe;
+  struct __kernel_timespec ts;
+  int total;
+
+  if (fileio_Aio_rings == NULL || owner_index < 0 || owner_index >= fileio_Aio_num_rings)
+    {
+      return 0;
+    }
+  aio_ring = &fileio_Aio_rings[owner_index];
+  if (!aio_ring->is_inited)
+    {
+      return 0;
+    }
+
+  if (wait_msecs == 0)
+    {
+      /* a thread waiting for one of the ring's pages may sit in the kernel with the mutex: it takes the
+       * completions, so the caller that must not wait leaves them to it */
+      if (pthread_mutex_trylock (&aio_ring->cq_mutex) != 0)
+	{
+	  return 0;
+	}
+    }
+  else
+    {
+      pthread_mutex_lock (&aio_ring->cq_mutex);
+    }
+  total = fileio_aio_drain_locked (thread_p, aio_ring, done);
+  if (total == 0 && wait_msecs > 0 && aio_ring->inflight > 0)
+    {
+      ts.tv_sec = wait_msecs / 1000;
+      ts.tv_nsec = (long long) (wait_msecs % 1000) * 1000000LL;
+      (void) io_uring_wait_cqe_timeout (&aio_ring->ring, &cqe, &ts);
+      total = fileio_aio_drain_locked (thread_p, aio_ring, done);
+    }
+  pthread_mutex_unlock (&aio_ring->cq_mutex);
+  return total;
+}
+
+/*
+ * fileio_aio_pending () - requests of a thread's ring that are staged or not yet reaped
+ */
+int
+fileio_aio_pending (int owner_index)
+{
+  if (fileio_Aio_rings == NULL || owner_index < 0 || owner_index >= fileio_Aio_num_rings)
+    {
+      return 0;
+    }
+  return fileio_Aio_rings[owner_index].staged + fileio_Aio_rings[owner_index].inflight;
+}
+#else /* !HAVE_LIBURING */
+bool
+fileio_aio_is_available (void)
+{
+  return false;
+}
+
+void
+fileio_aio_finalize (void)
+{
+}
+
+int
+fileio_aio_prepare_read (THREAD_ENTRY * thread_p, int vol_fd, void *io_page_p, PAGEID page_id, size_t page_size,
+			 void *cookie)
+{
+  return ER_FAILED;
+}
+
+int
+fileio_aio_submit (THREAD_ENTRY * thread_p, FILEIO_AIO_DONE_FUNC done)
+{
+  return 0;
+}
