--------------------------- MODULE BatchJoinTrace ---------------------------
(* Trace validation: is a batched nested-loop join an instrumented build ran a behavior of BatchJoin?
   The runs join the model's own tables (five outer rows with the keys k1 k2 k1 k3 k2; three inner rows
   for k1, one for k2), with the OID buffer and the stored-rows bound of the build set to the model's
   BufCap and MaxOuter.  The join type and the inner rows the statement's filter accepts are the run's
   (BatchJoinTraceData, generated by traces/join/nlb2tla.py).
   Every logged event must be the action it names, for the outer row it names, and a row must be answered
   the way the build answered it (memoize, the stored OIDs, the row's own index search).  A join row is
   logged by its outer row only: the model decides how many each outer row returns.
   Not logged, and taken here only before a new execution: the consumer of the join stops asking (LIMIT).
   Accepted iff TLC reaches i = Len(TraceLog). *)
EXTENDS BatchJoin, BatchJoinTraceData

CONSTANTS TraceLog, TraceJt, TracePass
VARIABLE i
TVars == <<vars, i>>

TInit == Init /\ jt = TraceJt /\ pass = TracePass /\ i = 0
Ev == TraceLog[i + 1]

Logged ==
  /\ i < Len(TraceLog)
  /\ i' = i + 1
  /\ \/ /\ Ev.a = "Hold"
        /\ next = Ev.o
        /\ AddOuter(Ev.kind)
     \/ /\ Ev.a = "Pass"
        /\ next = Ev.o
        /\ PassRow
        /\ how' = Ev.how
     \/ /\ Ev.a = "Close"
        /\ CloseBatch
     \/ /\ Ev.a = "Open"
        /\ OpenRow
        /\ cur' = Ev.o
        /\ how' = Ev.how
     \/ /\ Ev.a = "Emit"
        /\ cur = Ev.o
        /\ EmitOne
     \/ /\ Ev.a = "RowDone"
        /\ cur = Ev.o
        /\ RowDone
     \/ /\ Ev.a = "EndBatch"
        /\ EndBatch
     \/ /\ Ev.a = "MemoDrop"
        /\ MemoDrop
     \/ /\ Ev.a = "Stop"
        /\ Stop
     \/ /\ Ev.a = "Restart"
        /\ Restart

Hidden ==
  /\ i < Len(TraceLog)
  /\ UNCHANGED i
  /\ Ev.a = "Restart"
  /\ Stop

TSpec == TInit /\ [][Logged \/ Hidden]_TVars

TraceNotDone == i < Len(TraceLog)
=============================================================================
