------------------------ MODULE CmpDispatch_proofs ------------------------
(* TLAPS proof that IndInv is inductive for the correct variant (7c1130bed with
   the mirror fix) and implies C1-C3, for every MaxV (premises of INV1).
   Generated by gen_proofs.py: per client and type pair, the decision, the
   unpacked compare and its mirror are each proved equal to a record literal,
   then each site's C1 and typing follow from those equations. *)
EXTENDS CmpDispatch, TLAPS

ASSUME Correct == Mutant = "none"

\* C1 at one decision: the installed cmpval reads the types its consumer hands over
SafeAt(c, s, a, b) ==
  LET i == Installed(c, s, a, b)
      lf == IF s = "expr" /\ ExprLeaf(Unpack(Decide(c, a, b))) THEN TRUE ELSE FALSE
  IN  ~(s = "expr" /\ lf = FALSE) => Reads(i.cmp) = (IF lf = TRUE THEN i.src ELSE Actual(i))
InstOK(c, s, a, b) == Decide(c, a, b) \in Compares /\ Installed(c, s, a, b) \in Compares
\* C3 at one decision
NewExactAt(s, a, b) ==
  Exact(a, b) => /\ Installed("new", s, a, b).conv = <<0, 0>>
                 /\ Installed("new", s, a, b).cmp.kind = "exact"
                 /\ (s = "expr" => ExprLeaf(Unpack(Decide("new", a, b))))
AllAt(c, s, a, b) == SafeAt(c, s, a, b) /\ InstOK(c, s, a, b) /\ (c = "new" => NewExactAt(s, a, b))

LEMMA All == \A c \in Clients, s \in Sites, a \in Types, b \in Types :
              (s = "decide" => c = "new") => AllAt(c, s, a, b)
<1> USE Correct
<1>1. \A s \in Sites : (s = "decide" => "old" = "new") => AllAt("old", s, "SHORT", "SHORT")
  <2>a. Exact("SHORT", "SHORT") = FALSE
    BY DEF Exact, Ints
  <2>b. DecSkip("old", "SHORT", "SHORT") = FALSE
    BY <2>a DEF DecSkip
  <2>c. DecTarget("SHORT", "SHORT") = "SHORT"
    BY DEF DecTarget, Rank
  <2>g. DecConvNone("old", "SHORT", "SHORT") = TRUE
    BY <2>b DEF DecConvNone
  <2>d. DecConv("old", "SHORT", "SHORT") = <<0, 0>>
    BY <2>g, <2>c DEF DecConv
  <2>e. DecAfter0("old", "SHORT", "SHORT") = "SHORT"
    BY <2>c, <2>d DEF DecAfter0
  <2>f. Generic("SHORT") = [kind |-> "generic", type |-> "SHORT", numFirst |-> FALSE]
    BY DEF Generic
  <2>1. Decide("old", "SHORT", "SHORT") = [method |-> "DIRECT", src |-> <<"SHORT", "SHORT">>, conv |-> <<0, 0>>, target |-> "SHORT", cmp |-> [kind |-> "generic", type |-> "SHORT", numFirst |-> FALSE]]
    <3>1. Decide("old", "SHORT", "SHORT").method = "DIRECT" /\ Decide("old", "SHORT", "SHORT").src = <<"SHORT", "SHORT">>
      BY <2>g DEF Decide
    <3>2. Decide("old", "SHORT", "SHORT").conv = <<0, 0>> /\ Decide("old", "SHORT", "SHORT").target = "SHORT"
      BY <2>c, <2>d DEF Decide
    <3>3. Decide("old", "SHORT", "SHORT").cmp = [kind |-> "generic", type |-> "SHORT", numFirst |-> FALSE]
      BY <2>g, <2>e, <2>f DEF Decide
    <3>. QED  BY <3>1, <3>2, <3>3 DEF Decide
  <2>2. Unpack([method |-> "DIRECT", src |-> <<"SHORT", "SHORT">>, conv |-> <<0, 0>>, target |-> "SHORT", cmp |-> [kind |-> "generic", type |-> "SHORT", numFirst |-> FALSE]]) = [method |-> "DIRECT", src |-> <<"SHORT", "SHORT">>, conv |-> <<0, 0>>, target |-> "SHORT", cmp |-> [kind |-> "generic", type |-> "SHORT", numFirst |-> FALSE]]
    BY DEF Unpack, Generic, DomainCompareCmp, ExactCmp, IntIndex, Exact, Ints, Rank
  <2>3. Mirror([method |-> "DIRECT", src |-> <<"SHORT", "SHORT">>, conv |-> <<0, 0>>, target |-> "SHORT", cmp |-> [kind |-> "generic", type |-> "SHORT", numFirst |-> FALSE]]) = [method |-> "DIRECT", src |-> <<"SHORT", "SHORT">>, conv |-> <<0, 0>>, target |-> "SHORT", cmp |-> [kind |-> "generic", type |-> "SHORT", numFirst |-> FALSE]]
    BY DEF Mirror, Generic, DomainCompareCmp, ExactCmp, IntIndex, Exact, Ints, Rank
  <2>4. /\ [method |-> "DIRECT", src |-> <<"SHORT", "SHORT">>, conv |-> <<0, 0>>, target |-> "SHORT", cmp |-> [kind |-> "generic", type |-> "SHORT", numFirst |-> FALSE]] \in Compares /\ [method |-> "DIRECT", src |-> <<"SHORT", "SHORT">>, conv |-> <<0, 0>>, target |-> "SHORT", cmp |-> [kind |-> "generic", type |-> "SHORT", numFirst |-> FALSE]] \in Compares /\ [method |-> "DIRECT", src |-> <<"SHORT", "SHORT">>, conv |-> <<0, 0>>, target |-> "SHORT", cmp |-> [kind |-> "generic", type |-> "SHORT", numFirst |-> FALSE]] \in Compares
    BY DEF Compares, Cmps, Types, Ints, Bools
  <2>5. /\ Reads(([method |-> "DIRECT", src |-> <<"SHORT", "SHORT">>, conv |-> <<0, 0>>, target |-> "SHORT", cmp |-> [kind |-> "generic", type |-> "SHORT", numFirst |-> FALSE]]).cmp) = Actual([method |-> "DIRECT", src |-> <<"SHORT", "SHORT">>, conv |-> <<0, 0>>, target |-> "SHORT", cmp |-> [kind |-> "generic", type |-> "SHORT", numFirst |-> FALSE]])
        /\ Reads(([method |-> "DIRECT", src |-> <<"SHORT", "SHORT">>, conv |-> <<0, 0>>, target |-> "SHORT", cmp |-> [kind |-> "generic", type |-> "SHORT", numFirst |-> FALSE]]).cmp) = Actual([method |-> "DIRECT", src |-> <<"SHORT", "SHORT">>, conv |-> <<0, 0>>, target |-> "SHORT", cmp |-> [kind |-> "generic", type |-> "SHORT", numFirst |-> FALSE]])
        /\ Reads(([method |-> "DIRECT", src |-> <<"SHORT", "SHORT">>, conv |-> <<0, 0>>, target |-> "SHORT", cmp |-> [kind |-> "generic", type |-> "SHORT", numFirst |-> FALSE]]).cmp) = Actual([method |-> "DIRECT", src |-> <<"SHORT", "SHORT">>, conv |-> <<0, 0>>, target |-> "SHORT", cmp |-> [kind |-> "generic", type |-> "SHORT", numFirst |-> FALSE]])
    BY DEF Reads, Actual
  <2>6. ExprLeaf([method |-> "DIRECT", src |-> <<"SHORT", "SHORT">>, conv |-> <<0, 0>>, target |-> "SHORT", cmp |-> [kind |-> "generic", type |-> "SHORT", numFirst |-> FALSE]]) = FALSE
    BY <2>a DEF ExprLeaf
  <2>7. TRUE
    OBVIOUS
  <2>8. Installed("old", "unpack", "SHORT", "SHORT") = [method |-> "DIRECT", src |-> <<"SHORT", "SHORT">>, conv |-> <<0, 0>>, target |-> "SHORT", cmp |-> [kind |-> "generic", type |-> "SHORT", numFirst |-> FALSE]]
    BY <2>1, <2>2, <2>3 DEF Installed
  <2>9. AllAt("old", "unpack", "SHORT", "SHORT")
    <3>1. SafeAt("old", "unpack", "SHORT", "SHORT")
      BY <2>a, <2>1, <2>2, <2>4, <2>5, <2>6, <2>7, <2>8 DEF SafeAt
    <3>2. InstOK("old", "unpack", "SHORT", "SHORT")
      BY <2>a, <2>1, <2>2, <2>4, <2>5, <2>6, <2>7, <2>8 DEF InstOK
    <3>. QED  BY <3>1, <3>2 DEF AllAt
  <2>10. Installed("old", "expr", "SHORT", "SHORT") = [method |-> "DIRECT", src |-> <<"SHORT", "SHORT">>, conv |-> <<0, 0>>, target |-> "SHORT", cmp |-> [kind |-> "generic", type |-> "SHORT", numFirst |-> FALSE]]
    BY <2>1, <2>2, <2>3 DEF Installed
  <2>11. AllAt("old", "expr", "SHORT", "SHORT")
    <3>1. SafeAt("old", "expr", "SHORT", "SHORT")
      BY <2>a, <2>1, <2>2, <2>4, <2>5, <2>6, <2>7, <2>10 DEF SafeAt
    <3>2. InstOK("old", "expr", "SHORT", "SHORT")
      BY <2>a, <2>1, <2>2, <2>4, <2>5, <2>6, <2>7, <2>10 DEF InstOK
    <3>. QED  BY <3>1, <3>2 DEF AllAt
  <2>12. Installed("old", "mirror", "SHORT", "SHORT") = [method |-> "DIRECT", src |-> <<"SHORT", "SHORT">>, conv |-> <<0, 0>>, target |-> "SHORT", cmp |-> [kind |-> "generic", type |-> "SHORT", numFirst |-> FALSE]]
    BY <2>1, <2>2, <2>3 DEF Installed
  <2>13. AllAt("old", "mirror", "SHORT", "SHORT")
