    BY DEF Exact, Ints
  <2>b. DecSkip("new", "DOUBLE", "DOUBLE") = FALSE
    BY <2>a DEF DecSkip
  <2>c. DecTarget("DOUBLE", "DOUBLE") = "DOUBLE"
    BY DEF DecTarget, Rank
  <2>g. DecConvNone("new", "DOUBLE", "DOUBLE") = TRUE
    BY <2>b DEF DecConvNone
  <2>d. DecConv("new", "DOUBLE", "DOUBLE") = <<0, 0>>
    BY <2>g, <2>c DEF DecConv
  <2>e. DecAfter0("new", "DOUBLE", "DOUBLE") = "DOUBLE"
    BY <2>c, <2>d DEF DecAfter0
  <2>f. DomainCompareCmp("DOUBLE", "DOUBLE", "DOUBLE") = [kind |-> "generic", type |-> "DOUBLE", numFirst |-> FALSE]
    BY <2>a DEF DomainCompareCmp, ExactCmp, IntIndex, Generic
  <2>1. Decide("new", "DOUBLE", "DOUBLE") = [method |-> "DIRECT", src |-> <<"DOUBLE", "DOUBLE">>, conv |-> <<0, 0>>, target |-> "DOUBLE", cmp |-> [kind |-> "generic", type |-> "DOUBLE", numFirst |-> FALSE]]
    <3>1. Decide("new", "DOUBLE", "DOUBLE").method = "DIRECT" /\ Decide("new", "DOUBLE", "DOUBLE").src = <<"DOUBLE", "DOUBLE">>
      BY <2>g DEF Decide
    <3>2. Decide("new", "DOUBLE", "DOUBLE").conv = <<0, 0>> /\ Decide("new", "DOUBLE", "DOUBLE").target = "DOUBLE"
      BY <2>c, <2>d DEF Decide
    <3>3. Decide("new", "DOUBLE", "DOUBLE").cmp = [kind |-> "generic", type |-> "DOUBLE", numFirst |-> FALSE]
      BY <2>g, <2>e, <2>f DEF Decide
    <3>. QED  BY <3>1, <3>2, <3>3 DEF Decide
  <2>2. Unpack([method |-> "DIRECT", src |-> <<"DOUBLE", "DOUBLE">>, conv |-> <<0, 0>>, target |-> "DOUBLE", cmp |-> [kind |-> "generic", type |-> "DOUBLE", numFirst |-> FALSE]]) = [method |-> "DIRECT", src |-> <<"DOUBLE", "DOUBLE">>, conv |-> <<0, 0>>, target |-> "DOUBLE", cmp |-> [kind |-> "generic", type |-> "DOUBLE", numFirst |-> FALSE]]
    BY DEF Unpack, Generic, DomainCompareCmp, ExactCmp, IntIndex, Exact, Ints, Rank
  <2>3. Mirror([method |-> "DIRECT", src |-> <<"DOUBLE", "DOUBLE">>, conv |-> <<0, 0>>, target |-> "DOUBLE", cmp |-> [kind |-> "generic", type |-> "DOUBLE", numFirst |-> FALSE]]) = [method |-> "DIRECT", src |-> <<"DOUBLE", "DOUBLE">>, conv |-> <<0, 0>>, target |-> "DOUBLE", cmp |-> [kind |-> "generic", type |-> "DOUBLE", numFirst |-> FALSE]]
    BY DEF Mirror, Generic, DomainCompareCmp, ExactCmp, IntIndex, Exact, Ints, Rank
  <2>4. /\ [method |-> "DIRECT", src |-> <<"DOUBLE", "DOUBLE">>, conv |-> <<0, 0>>, target |-> "DOUBLE", cmp |-> [kind |-> "generic", type |-> "DOUBLE", numFirst |-> FALSE]] \in Compares /\ [method |-> "DIRECT", src |-> <<"DOUBLE", "DOUBLE">>, conv |-> <<0, 0>>, target |-> "DOUBLE", cmp |-> [kind |-> "generic", type |-> "DOUBLE", numFirst |-> FALSE]] \in Compares /\ [method |-> "DIRECT", src |-> <<"DOUBLE", "DOUBLE">>, conv |-> <<0, 0>>, target |-> "DOUBLE", cmp |-> [kind |-> "generic", type |-> "DOUBLE", numFirst |-> FALSE]] \in Compares
    BY DEF Compares, Cmps, Types, Ints, Bools
  <2>5. /\ Reads(([method |-> "DIRECT", src |-> <<"DOUBLE", "DOUBLE">>, conv |-> <<0, 0>>, target |-> "DOUBLE", cmp |-> [kind |-> "generic", type |-> "DOUBLE", numFirst |-> FALSE]]).cmp) = Actual([method |-> "DIRECT", src |-> <<"DOUBLE", "DOUBLE">>, conv |-> <<0, 0>>, target |-> "DOUBLE", cmp |-> [kind |-> "generic", type |-> "DOUBLE", numFirst |-> FALSE]])
        /\ Reads(([method |-> "DIRECT", src |-> <<"DOUBLE", "DOUBLE">>, conv |-> <<0, 0>>, target |-> "DOUBLE", cmp |-> [kind |-> "generic", type |-> "DOUBLE", numFirst |-> FALSE]]).cmp) = Actual([method |-> "DIRECT", src |-> <<"DOUBLE", "DOUBLE">>, conv |-> <<0, 0>>, target |-> "DOUBLE", cmp |-> [kind |-> "generic", type |-> "DOUBLE", numFirst |-> FALSE]])
        /\ Reads(([method |-> "DIRECT", src |-> <<"DOUBLE", "DOUBLE">>, conv |-> <<0, 0>>, target |-> "DOUBLE", cmp |-> [kind |-> "generic", type |-> "DOUBLE", numFirst |-> FALSE]]).cmp) = Actual([method |-> "DIRECT", src |-> <<"DOUBLE", "DOUBLE">>, conv |-> <<0, 0>>, target |-> "DOUBLE", cmp |-> [kind |-> "generic", type |-> "DOUBLE", numFirst |-> FALSE]])
    BY DEF Reads, Actual
  <2>6. ExprLeaf([method |-> "DIRECT", src |-> <<"DOUBLE", "DOUBLE">>, conv |-> <<0, 0>>, target |-> "DOUBLE", cmp |-> [kind |-> "generic", type |-> "DOUBLE", numFirst |-> FALSE]]) = FALSE
    BY <2>a DEF ExprLeaf
  <2>7. TRUE
    OBVIOUS
  <2>8. Installed("new", "decide", "DOUBLE", "DOUBLE") = [method |-> "DIRECT", src |-> <<"DOUBLE", "DOUBLE">>, conv |-> <<0, 0>>, target |-> "DOUBLE", cmp |-> [kind |-> "generic", type |-> "DOUBLE", numFirst |-> FALSE]]
    BY <2>1, <2>2, <2>3 DEF Installed
  <2>9. AllAt("new", "decide", "DOUBLE", "DOUBLE")
    <3>1. SafeAt("new", "decide", "DOUBLE", "DOUBLE")
      BY <2>a, <2>1, <2>2, <2>4, <2>5, <2>6, <2>7, <2>8 DEF SafeAt
    <3>2. InstOK("new", "decide", "DOUBLE", "DOUBLE")
      BY <2>a, <2>1, <2>2, <2>4, <2>5, <2>6, <2>7, <2>8 DEF InstOK
    <3>3. Installed("new", "decide", "DOUBLE", "DOUBLE").conv = <<0, 0>>
          /\ Installed("new", "decide", "DOUBLE", "DOUBLE").cmp.kind = "generic"
      BY <2>8
    <3>4. ExprLeaf(Unpack(Decide("new", "DOUBLE", "DOUBLE"))) = FALSE
      BY <2>1, <2>2, <2>6
    <3>5. NewExactAt("decide", "DOUBLE", "DOUBLE")
      BY <2>a, <3>3, <3>4 DEF NewExactAt
    <3>. QED  BY <3>1, <3>2, <3>5 DEF AllAt
  <2>10. Installed("new", "unpack", "DOUBLE", "DOUBLE") = [method |-> "DIRECT", src |-> <<"DOUBLE", "DOUBLE">>, conv |-> <<0, 0>>, target |-> "DOUBLE", cmp |-> [kind |-> "generic", type |-> "DOUBLE", numFirst |-> FALSE]]
    BY <2>1, <2>2, <2>3 DEF Installed
  <2>11. AllAt("new", "unpack", "DOUBLE", "DOUBLE")
    <3>1. SafeAt("new", "unpack", "DOUBLE", "DOUBLE")
      BY <2>a, <2>1, <2>2, <2>4, <2>5, <2>6, <2>7, <2>10 DEF SafeAt
    <3>2. InstOK("new", "unpack", "DOUBLE", "DOUBLE")
      BY <2>a, <2>1, <2>2, <2>4, <2>5, <2>6, <2>7, <2>10 DEF InstOK
    <3>3. Installed("new", "unpack", "DOUBLE", "DOUBLE").conv = <<0, 0>>
          /\ Installed("new", "unpack", "DOUBLE", "DOUBLE").cmp.kind = "generic"
      BY <2>10
    <3>4. ExprLeaf(Unpack(Decide("new", "DOUBLE", "DOUBLE"))) = FALSE
      BY <2>1, <2>2, <2>6
    <3>5. NewExactAt("unpack", "DOUBLE", "DOUBLE")
      BY <2>a, <3>3, <3>4 DEF NewExactAt
    <3>. QED  BY <3>1, <3>2, <3>5 DEF AllAt
  <2>12. Installed("new", "expr", "DOUBLE", "DOUBLE") = [method |-> "DIRECT", src |-> <<"DOUBLE", "DOUBLE">>, conv |-> <<0, 0>>, target |-> "DOUBLE", cmp |-> [kind |-> "generic", type |-> "DOUBLE", numFirst |-> FALSE]]
    BY <2>1, <2>2, <2>3 DEF Installed
  <2>13. AllAt("new", "expr", "DOUBLE", "DOUBLE")
    <3>1. SafeAt("new", "expr", "DOUBLE", "DOUBLE")
      BY <2>a, <2>1, <2>2, <2>4, <2>5, <2>6, <2>7, <2>12 DEF SafeAt
    <3>2. InstOK("new", "expr", "DOUBLE", "DOUBLE")
      BY <2>a, <2>1, <2>2, <2>4, <2>5, <2>6, <2>7, <2>12 DEF InstOK
    <3>3. Installed("new", "expr", "DOUBLE", "DOUBLE").conv = <<0, 0>>
          /\ Installed("new", "expr", "DOUBLE", "DOUBLE").cmp.kind = "generic"
      BY <2>12
    <3>4. ExprLeaf(Unpack(Decide("new", "DOUBLE", "DOUBLE"))) = FALSE
      BY <2>1, <2>2, <2>6
    <3>5. NewExactAt("expr", "DOUBLE", "DOUBLE")
      BY <2>a, <3>3, <3>4 DEF NewExactAt
    <3>. QED  BY <3>1, <3>2, <3>5 DEF AllAt
  <2>14. Installed("new", "mirror", "DOUBLE", "DOUBLE") = [method |-> "DIRECT", src |-> <<"DOUBLE", "DOUBLE">>, conv |-> <<0, 0>>, target |-> "DOUBLE", cmp |-> [kind |-> "generic", type |-> "DOUBLE", numFirst |-> FALSE]]
    BY <2>1, <2>2, <2>3 DEF Installed
  <2>15. AllAt("new", "mirror", "DOUBLE", "DOUBLE")
    <3>1. SafeAt("new", "mirror", "DOUBLE", "DOUBLE")
      BY <2>a, <2>1, <2>2, <2>4, <2>5, <2>6, <2>7, <2>14 DEF SafeAt
    <3>2. InstOK("new", "mirror", "DOUBLE", "DOUBLE")
      BY <2>a, <2>1, <2>2, <2>4, <2>5, <2>6, <2>7, <2>14 DEF InstOK
    <3>3. Installed("new", "mirror", "DOUBLE", "DOUBLE").conv = <<0, 0>>
          /\ Installed("new", "mirror", "DOUBLE", "DOUBLE").cmp.kind = "generic"
      BY <2>14
    <3>4. ExprLeaf(Unpack(Decide("new", "DOUBLE", "DOUBLE"))) = FALSE
      BY <2>1, <2>2, <2>6
    <3>5. NewExactAt("mirror", "DOUBLE", "DOUBLE")
      BY <2>a, <3>3, <3>4 DEF NewExactAt
    <3>. QED  BY <3>1, <3>2, <3>5 DEF AllAt
  <2>. QED  BY <2>9, <2>11, <2>13, <2>15 DEF Sites
<1>m00. \A s \in Sites, b \in Types : (s = "decide" => "old" = "new") => AllAt("old", s, "SHORT", b)
  BY <1>1, <1>2, <1>3, <1>4, <1>5 DEF Types, Ints
<1>m01. \A s \in Sites, b \in Types : (s = "decide" => "old" = "new") => AllAt("old", s, "INT", b)
  BY <1>6, <1>7, <1>8, <1>9, <1>10 DEF Types, Ints
<1>m02. \A s \in Sites, b \in Types : (s = "decide" => "old" = "new") => AllAt("old", s, "BIGINT", b)
  BY <1>11, <1>12, <1>13, <1>14, <1>15 DEF Types, Ints
<1>m03. \A s \in Sites, b \in Types : (s = "decide" => "old" = "new") => AllAt("old", s, "NUMERIC", b)
  BY <1>16, <1>17, <1>18, <1>19, <1>20 DEF Types, Ints
<1>m04. \A s \in Sites, b \in Types : (s = "decide" => "old" = "new") => AllAt("old", s, "DOUBLE", b)
  BY <1>21, <1>22, <1>23, <1>24, <1>25 DEF Types, Ints
<1>n0. \A s \in Sites, a \in Types, b \in Types : (s = "decide" => "old" = "new") => AllAt("old", s, a, b)
  BY <1>m00, <1>m01, <1>m02, <1>m03, <1>m04 DEF Types, Ints
<1>m10. \A s \in Sites, b \in Types : (s = "decide" => "new" = "new") => AllAt("new", s, "SHORT", b)
  BY <1>26, <1>27, <1>28, <1>29, <1>30 DEF Types, Ints
<1>m11. \A s \in Sites, b \in Types : (s = "decide" => "new" = "new") => AllAt("new", s, "INT", b)
  BY <1>31, <1>32, <1>33, <1>34, <1>35 DEF Types, Ints
<1>m12. \A s \in Sites, b \in Types : (s = "decide" => "new" = "new") => AllAt("new", s, "BIGINT", b)
  BY <1>36, <1>37, <1>38, <1>39, <1>40 DEF Types, Ints
<1>m13. \A s \in Sites, b \in Types : (s = "decide" => "new" = "new") => AllAt("new", s, "NUMERIC", b)
  BY <1>41, <1>42, <1>43, <1>44, <1>45 DEF Types, Ints
<1>m14. \A s \in Sites, b \in Types : (s = "decide" => "new" = "new") => AllAt("new", s, "DOUBLE", b)
  BY <1>46, <1>47, <1>48, <1>49, <1>50 DEF Types, Ints
<1>n1. \A s \in Sites, a \in Types, b \in Types : (s = "decide" => "new" = "new") => AllAt("new", s, a, b)
  BY <1>m10, <1>m11, <1>m12, <1>m13, <1>m14 DEF Types, Ints
<1>. QED  BY <1>n0, <1>n1 DEF Clients

THEOREM InitInv == Init => IndInv
<1> SUFFICES ASSUME Init PROVE IndInv
  OBVIOUS
<1> USE Assm
<1>1. None \in Compares
  BY DEF None, Compares, Cmps, Generic, Types, Ints, Bools
<1>2. phase = "decide" /\ dec = None /\ inst = None /\ leaf = FALSE /\ bad = FALSE
      /\ wrong = FALSE /\ usedExact = FALSE
  BY DEF Init
<1>3. client \in Clients /\ site \in Sites /\ ty \in Types \X Types /\ val \in Vals \X Vals
      /\ (site = "decide" => client = "new") /\ Holds(ty[1], val[1]) /\ Holds(ty[2], val[2])
  BY DEF Init
<1>4. TypeOK
  BY <1>1, <1>2, <1>3 DEF TypeOK, Phases, Bools
<1>. QED  BY <1>1, <1>2, <1>3, <1>4 DEF IndInv, Phases

THEOREM StepInv == IndInv /\ [Next]_vars => IndInv'
<1> SUFFICES ASSUME IndInv, [Next]_vars PROVE IndInv'
  OBVIOUS
<1> USE Assm, Correct
<1>0. /\ phase \in Phases /\ client \in Clients /\ site \in Sites /\ ty \in Types \X Types
      /\ val \in Vals \X Vals /\ (site = "decide" => client = "new")
      /\ ty[1] \in Types /\ ty[2] \in Types
      /\ Holds(ty[1], val[1]) /\ Holds(ty[2], val[2])
  BY DEF IndInv, TypeOK
<1>c. AllAt(client, site, ty[1], ty[2])
  BY <1>0, All
<1>a. Decide(client, ty[1], ty[2]) \in Compares /\ Installed(client, site, ty[1], ty[2]) \in Compares
  BY <1>c DEF AllAt, InstOK
<1>b. SafeAt(client, site, ty[1], ty[2])
  BY <1>c DEF AllAt
<1>n. None \in Compares
  BY DEF None, Compares, Cmps, Generic, Types, Ints, Bools
\* the conjuncts of IndInv' that only need the unchanged inputs
<1>u. ASSUME UNCHANGED <<client, site, ty, val>>
      PROVE  /\ client' \in Clients /\ site' \in Sites /\ ty' \in Types \X Types /\ val' \in Vals \X Vals
             /\ (site' = "decide" => client' = "new") /\ Holds(ty'[1], val'[1]) /\ Holds(ty'[2], val'[2])
  BY <1>0, <1>u
<1>1. CASE DecideStep
  <2>1. phase = "decide" /\ phase' = "install" /\ dec' = Decide(client, ty[1], ty[2])
        /\ UNCHANGED <<client, site, ty, val, inst, leaf, bad, wrong, usedExact>>
    BY <1>1 DEF DecideStep
  <2>2. inst = None /\ leaf = FALSE /\ bad = FALSE /\ wrong = FALSE /\ usedExact = FALSE
    BY <2>1 DEF IndInv
  <2>3. inst' = None /\ leaf' = FALSE /\ bad' = FALSE /\ wrong' = FALSE /\ usedExact' = FALSE
    BY <2>1, <2>2
  <2>4. phase' \in Phases /\ dec' \in Compares /\ inst' \in Compares
    BY <1>a, <1>n, <2>1, <2>3 DEF Phases
  <2>5. leaf' \in Bools /\ bad' \in Bools /\ wrong' \in Bools /\ usedExact' \in Bools
    BY <2>3 DEF Bools
  <2>6. TypeOK'
    BY <1>u, <2>1, <2>4, <2>5 DEF TypeOK
  <2>7. /\ dec' = IF phase' = "decide" THEN None ELSE Decide(client', ty'[1], ty'[2])
        /\ inst' = IF phase' \in {"eval", "done"} THEN Installed(client', site', ty'[1], ty'[2]) ELSE None
        /\ leaf' = IF phase' \in {"eval", "done"} /\ site' = "expr" /\ ExprLeaf(Unpack(dec')) THEN TRUE ELSE FALSE
        /\ usedExact' = IF phase' = "done" /\ ~(site' = "expr" /\ leaf' = FALSE) /\ inst'.cmp.kind = "exact" THEN TRUE ELSE FALSE
    BY <2>1, <2>3
  <2>. QED  BY <1>u, <2>1, <2>3, <2>4, <2>6, <2>7 DEF IndInv
<1>2. CASE Install
  <2>p. phase = "install" /\ phase' = "eval"
    BY <1>2 DEF Install
  <2>u. client' = client /\ site' = site /\ ty' = ty /\ val' = val /\ dec' = dec /\ bad' = bad
        /\ wrong' = wrong /\ usedExact' = usedExact
    BY <1>2 DEF Install
  <2>2. dec = Decide(client, ty[1], ty[2]) /\ bad = FALSE /\ wrong = FALSE /\ usedExact = FALSE
    BY <2>p DEF IndInv
  <2>3. inst' = Installed(client, site, ty[1], ty[2])
    BY <1>2, <1>0, <2>2 DEF Install, Installed, Sites
  <2>l. leaf' = IF site = "expr" /\ ExprLeaf(Unpack(dec)) THEN TRUE ELSE FALSE
    BY <1>2 DEF Install
  <2>4. phase' \in Phases /\ dec' \in Compares /\ inst' \in Compares
    BY <1>a, <2>p, <2>u, <2>2, <2>3 DEF Phases
  <2>5. leaf' \in Bools /\ bad' = FALSE /\ wrong' = FALSE /\ usedExact' = FALSE
    BY <2>l, <2>u, <2>2 DEF Bools
  <2>6. bad' \in Bools /\ wrong' \in Bools /\ usedExact' \in Bools
    BY <2>5 DEF Bools
  <2>7. TypeOK'
    BY <1>u, <2>u, <2>4, <2>5, <2>6 DEF TypeOK
  <2>8. /\ dec' = IF phase' = "decide" THEN None ELSE Decide(client', ty'[1], ty'[2])
        /\ inst' = IF phase' \in {"eval", "done"} THEN Installed(client', site', ty'[1], ty'[2]) ELSE None
        /\ leaf' = IF phase' \in {"eval", "done"} /\ site' = "expr" /\ ExprLeaf(Unpack(dec')) THEN TRUE ELSE FALSE
        /\ usedExact' = IF phase' = "done" /\ ~(site' = "expr" /\ leaf' = FALSE) /\ inst'.cmp.kind = "exact" THEN TRUE ELSE FALSE
    BY <2>p, <2>u, <2>2, <2>3, <2>l, <2>5
  <2>h. client' \in Clients /\ site' \in Sites /\ ty' \in Types \X Types /\ val' \in Vals \X Vals
        /\ (site' = "decide" => client' = "new") /\ Holds(ty'[1], val'[1]) /\ Holds(ty'[2], val'[2])
    BY <1>0, <2>u
  <2>. QED  BY <2>h, <2>4, <2>5, <2>7, <2>8 DEF IndInv
<1>3. CASE Eval
  <2> DEFINE interp == site = "expr" /\ leaf = FALSE
             x == IF site = "mirror" THEN val[2] ELSE val[1]
             y == IF site = "mirror" THEN val[1] ELSE val[2]
             given == IF leaf = TRUE THEN inst.src ELSE Actual(inst)
             unsafe == ~interp /\ Reads(inst.cmp) # given
  <2>p. phase = "eval" /\ phase' = "done"
    BY <1>3 DEF Eval
  <2>u. client' = client /\ site' = site /\ ty' = ty /\ val' = val /\ dec' = dec /\ inst' = inst /\ leaf' = leaf
    BY <1>3 DEF Eval
  <2>2. inst = Installed(client, site, ty[1], ty[2]) /\ dec = Decide(client, ty[1], ty[2])
    BY <2>p DEF IndInv
  <2>2c. leaf = IF site = "expr" /\ ExprLeaf(Unpack(dec)) THEN TRUE ELSE FALSE
    BY <2>p DEF IndInv
  <2>l. leaf = IF site = "expr" /\ ExprLeaf(Unpack(Decide(client, ty[1], ty[2]))) THEN TRUE ELSE FALSE
    BY <2>p DEF IndInv
  <2>s. ~(site = "expr" /\ leaf = FALSE) => Reads(inst.cmp) = (IF leaf = TRUE THEN inst.src ELSE Actual(inst))
    BY <1>b, <2>2, <2>l DEF SafeAt
  <2>3. unsafe = FALSE
    BY <2>s DEF unsafe, interp, given
  <2>b. bad' = IF unsafe THEN TRUE ELSE FALSE
    BY <1>3 DEF Eval
  <2>4. bad' = FALSE
    BY <2>b, <2>3
  <2>5. Answer(inst.cmp, x, y) = Sign(x - y)
    BY DEF Answer
  <2>w. \E r \in IF unsafe THEN {-1, 0, 1} ELSE {IF interp THEN Sign(x - y) ELSE Answer(inst.cmp, x, y)} :
          wrong' = IF ~unsafe /\ r # Sign(x - y) THEN TRUE ELSE FALSE
    BY <1>3 DEF Eval
  <2>6. wrong' = FALSE
    BY <2>w, <2>3, <2>5 DEF unsafe, interp
  <2>e. usedExact' = IF ~interp /\ inst.cmp.kind = "exact" THEN TRUE ELSE FALSE
    BY <1>3 DEF Eval
  <2>lb. leaf \in Bools
    BY <2>2c DEF Bools
  <2>7. phase' \in Phases /\ dec' \in Compares /\ inst' \in Compares /\ leaf' \in Bools
    BY <1>a, <2>p, <2>u, <2>2, <2>lb DEF Phases, Bools
  <2>8. bad' \in Bools /\ wrong' \in Bools /\ usedExact' \in Bools
    BY <2>e, <2>4, <2>6 DEF Bools, interp
  <2>9. TypeOK'
    BY <1>u, <2>u, <2>7, <2>8 DEF TypeOK
  <2>10. /\ dec' = IF phase' = "decide" THEN None ELSE Decide(client', ty'[1], ty'[2])
         /\ inst' = IF phase' \in {"eval", "done"} THEN Installed(client', site', ty'[1], ty'[2]) ELSE None
         /\ leaf' = IF phase' \in {"eval", "done"} /\ site' = "expr" /\ ExprLeaf(Unpack(dec')) THEN TRUE ELSE FALSE
         /\ usedExact' = IF phase' = "done" /\ ~(site' = "expr" /\ leaf' = FALSE) /\ inst'.cmp.kind = "exact" THEN TRUE ELSE FALSE
    BY <2>p, <2>u, <2>2, <2>2c, <2>e DEF interp
  <2>h. client' \in Clients /\ site' \in Sites /\ ty' \in Types \X Types /\ val' \in Vals \X Vals
        /\ (site' = "decide" => client' = "new") /\ Holds(ty'[1], val'[1]) /\ Holds(ty'[2], val'[2])
    BY <1>0, <2>u
  <2>. QED  BY <2>h, <2>4, <2>6, <2>7, <2>9, <2>10 DEF IndInv
<1>4. CASE Done
  BY <1>4 DEF Done, vars, IndInv, TypeOK
<1>5. CASE UNCHANGED vars
  BY <1>5 DEF vars, IndInv, TypeOK
<1>. QED  BY <1>1, <1>2, <1>3, <1>4, <1>5 DEF Next

THEOREM InvSafe == IndInv => TypeSafe /\ ExactAnswer /\ NewExactPair
<1> SUFFICES ASSUME IndInv PROVE TypeSafe /\ ExactAnswer /\ NewExactPair
  OBVIOUS
<1> USE Assm, Correct
<1>1. TypeSafe /\ ExactAnswer
  BY DEF IndInv, TypeSafe, ExactAnswer
<1>2. ASSUME phase = "done", client = "new", Exact(ty[1], ty[2])
      PROVE usedExact /\ inst.conv = <<0, 0>>
  <2>1. ty[1] \in Types /\ ty[2] \in Types /\ site \in Sites
    BY DEF IndInv, TypeOK
  <2>2. inst = Installed("new", site, ty[1], ty[2]) /\ leaf = IF site = "expr" /\ ExprLeaf(Unpack(Decide("new", ty[1], ty[2]))) THEN TRUE ELSE FALSE
    BY <1>2 DEF IndInv
  <2>2u. usedExact = IF ~(site = "expr" /\ leaf = FALSE) /\ inst.cmp.kind = "exact" THEN TRUE ELSE FALSE
    BY <1>2 DEF IndInv
  <2>3. NewExactAt(site, ty[1], ty[2])
    <3>1. AllAt("new", site, ty[1], ty[2])
      BY <1>2, <2>1, All DEF Clients
    <3>. QED  BY <3>1 DEF AllAt
  <2>4. Installed("new", site, ty[1], ty[2]).conv = <<0, 0>> /\ Installed("new", site, ty[1], ty[2]).cmp.kind = "exact"
        /\ (site = "expr" => leaf = TRUE)
    BY <1>2, <2>2, <2>3 DEF NewExactAt
  <2>5. usedExact = TRUE
    <3>1. site = "expr" => leaf = TRUE
      BY <2>4
    <3>2. ~(site = "expr" /\ leaf = FALSE)
      BY <3>1
    <3>3. inst.cmp.kind = "exact"
      BY <2>2, <2>4
    <3>. QED  BY <2>2u, <3>2, <3>3
  <2>. QED  BY <1>2, <2>2, <2>4, <2>5
<1>. QED  BY <1>1, <1>2 DEF NewExactPair
=============================================================================
