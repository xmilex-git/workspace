+/*
+ * qexec_connect_by_path_index_bucket () - bucket of a cycle-check hash
+ *  return: bucket number
+ *  index(in):
+ *  hash(in):
+ */
+static unsigned int
+qexec_connect_by_path_index_bucket (const CONNECT_BY_PATH_INDEX * index, unsigned int hash)
+{
+  return (hash * CONNECT_BY_PATH_INDEX_HASH_MIX) >> index->shift;
+}
+
+/*
+ * qexec_connect_by_path_index_reserve () - make room for capacity path levels, rehashing the current path
+ *  return: error code
+ *  index(in/out):
+ *  path(in):
+ *  path_count(in): levels currently on the path and in the index
+ *  capacity(in): the path array capacity; grows geometrically, so the rehash is amortized
+ */
+static int
+qexec_connect_by_path_index_reserve (THREAD_ENTRY * thread_p, CONNECT_BY_PATH_INDEX * index,
+				     const CONNECT_BY_DFS_NODE * path, int path_count, int capacity)
+{
+  int *head, *next;
+  int log2_buckets, bucket_count, i;
+
+  if (capacity <= index->capacity)
+    {
+      return NO_ERROR;
+    }
+
+  /* at least two buckets per level keeps the chains short */
+  log2_buckets = CONNECT_BY_PATH_INDEX_MIN_BUCKETS_LOG2;
+  while ((1 << log2_buckets) < 2 * capacity)
+    {
+      log2_buckets++;
+    }
+  bucket_count = 1 << log2_buckets;
+
+  head = (int *) db_private_alloc (thread_p, bucket_count * sizeof (int));
+  next = (int *) db_private_alloc (thread_p, capacity * sizeof (int));
+  if (head == NULL || next == NULL)
+    {
+      if (head != NULL)
+	{
+	  db_private_free_and_init (thread_p, head);
+	}
+      if (next != NULL)
+	{
+	  db_private_free_and_init (thread_p, next);
+	}
+      er_set (ER_ERROR_SEVERITY, ARG_FILE_LINE, ER_OUT_OF_VIRTUAL_MEMORY, 1,
+	      (size_t) (bucket_count + capacity) * sizeof (int));
+      return ER_OUT_OF_VIRTUAL_MEMORY;
+    }
+
+  qexec_connect_by_path_index_clear (thread_p, index);
+  for (i = 0; i < bucket_count; i++)
+    {
+      head[i] = CONNECT_BY_PATH_INDEX_NONE;
+    }
+  index->head = head;
+  index->next = next;
+  index->capacity = capacity;
+  index->shift = 32 - log2_buckets;
+
+  /* shallowest first, so each chain ends up deepest first */
+  for (i = 0; i < path_count; i++)
+    {
+      qexec_connect_by_path_index_push (index, path, i);
+    }
+
+  return NO_ERROR;
+}
+
+/*
+ * qexec_connect_by_path_index_push () - chain the path level that was just placed
+ *  return:
+ *  index(in/out):
+ *  path(in):
+ *  level(in): the deepest level on the path
+ */
+static void
+qexec_connect_by_path_index_push (CONNECT_BY_PATH_INDEX * index, const CONNECT_BY_DFS_NODE * path, int level)
+{
+  unsigned int bucket = qexec_connect_by_path_index_bucket (index, path[level].hash);
+
+  assert (level < index->capacity);
+  index->next[level] = index->head[bucket];
+  index->head[bucket] = level;
+}
+
+/*
+ * qexec_connect_by_path_index_pop () - unchain the deepest path level
+ *  return:
+ *  index(in/out):
+ *  path(in):
+ *  level(in): the deepest level still chained
+ */
+static void
+qexec_connect_by_path_index_pop (CONNECT_BY_PATH_INDEX * index, const CONNECT_BY_DFS_NODE * path, int level)
+{
+  unsigned int bucket = qexec_connect_by_path_index_bucket (index, path[level].hash);
+
+  /* levels leave in reverse push order, so the popped level heads its chain */
+  assert (index->head[bucket] == level);
+  index->head[bucket] = index->next[level];
+}
+
+/*
+ * qexec_connect_by_path_index_clear () - free the path index
+ *  return:
+ *  index(in/out):
+ */
+static void
+qexec_connect_by_path_index_clear (THREAD_ENTRY * thread_p, CONNECT_BY_PATH_INDEX * index)
+{
+  if (index->head != NULL)
+    {
+      db_private_free_and_init (thread_p, index->head);
+    }
+  if (index->next != NULL)
+    {
+      db_private_free_and_init (thread_p, index->next);
+    }
+  index->capacity = 0;
+}
+
