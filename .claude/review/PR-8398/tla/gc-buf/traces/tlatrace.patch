+/* TLA+ trace instrumentation (scratch worktree for the PR 8398 review, never committed) */
+#include <atomic>
+#include <cstdarg>
+#include <pthread.h>
+static std::atomic<unsigned long long> tla_seq (0);
+static FILE *tla_fp = NULL;
+static bool tla_init_done = false;
+static pthread_mutex_t tla_mtx = PTHREAD_MUTEX_INITIALIZER;
+thread_local const void *tla_cur_node = NULL;
+thread_local int tla_spare = 0;
+thread_local const void *tla_first_addr = NULL;
+thread_local const char *tla_first_t = NULL;
+thread_local bool tla_grew = false;
+
+void
+tla_trace (const char *a, const void *node, const char *fmt, ...)
+{
+  va_list ap;
+  pthread_mutex_lock (&tla_mtx);
+  if (!tla_init_done)
+    {
+      const char *path = getenv ("CUBRID_TLATRACE_FILE");
+      tla_init_done = true;
+      if (path != NULL)
+	{
+	  tla_fp = fopen (path, "a");
+	}
+    }
+  if (tla_fp != NULL)
+    {
+      fprintf (tla_fp, "TLATRACE seq=%llu a=%s p=%p ", (unsigned long long) ++tla_seq, a, node);
+      va_start (ap, fmt);
+      vfprintf (tla_fp, fmt, ap);
+      va_end (ap);
+      fputc ('\n', tla_fp);
+      fflush (tla_fp);
+    }
+  pthread_mutex_unlock (&tla_mtx);
+}
