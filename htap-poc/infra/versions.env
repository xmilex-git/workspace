# Pinned images for the HTAP POC single-node stack (ticket #34).
# Change a pin here only — scripts source this file.
#
# NOTE: pins were finalized by actually pulling on the POC host; if a tag
# disappears upstream, prefer the nearest same-major .Final/point release.
KAFKA_IMAGE=docker.io/apache/kafka:3.8.1
CONNECT_IMAGE=quay.io/debezium/connect:3.0.0.Final
CLICKHOUSE_IMAGE=docker.io/clickhouse/clickhouse-server:24.8
# ClickHouse Kafka Connect Sink plugin (ticket #39) — installed by
# ../sink/install-sink-plugin.sh into $HTAP_DATA/connect-plugins/.
CLICKHOUSE_SINK_VERSION=v1.4.0
