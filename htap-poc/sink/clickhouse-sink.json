{
  "name": "clickhouse-sink-poc",
  "config": {
    "connector.class": "com.clickhouse.kafka.connect.ClickHouseSinkConnector",
    "tasks.max": "1",
    "hostname": "clickhouse",
    "port": "8123",
    "ssl": "false",
    "database": "htap",
    "username": "htap_sink",
    "password": "htap-sink-poc",

    "topics": "htapcdc.dba.t_order,htapcdc.dba.t_item,htapcdc.dba.t_typecorpus",
    "topic2TableMap": "htapcdc.dba.t_order=t_order_local,htapcdc.dba.t_item=t_item_local,htapcdc.dba.t_typecorpus=t_typecorpus_local",

    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",

    "exactlyOnce": "false",
    "errors.retry.timeout": "60000",
    "errors.tolerance": "none",
    "clickhouseSettings": "date_time_input_format=best_effort"
  }
}
